# Copy to .env (task install does this). The dashboard's orientation and Settings screens edit .env for you.

# LLM provider: openrouter | claude-code
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Default model for every role; per-role overrides below win.
OPENROUTER_MODEL=openai/gpt-6-luna
# Models ending in :batch use OpenRouter's async Batch API (half price, results within 24h): qualification only.
OPENROUTER_QUALIFY_MODEL=openai/gpt-6-luna:batch
# OPENROUTER_DISCOVERY_MODEL=
# OPENROUTER_TAILOR_MODEL=
# OPENROUTER_ORIENT_MODEL=

# Claude Code (uses your local `claude` login; no key)
# CLAUDE_MODEL=claude-opus-4-8
# CLAUDE_TAILOR_MODEL=

# Tavily web search (https://tavily.com), used by discovery agents and search queries
TAVILY_API_KEY=

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=job_hunter
# PGUSER defaults to your OS user
# PGUSER=
# PGPASSWORD=

# Optional tuning
# DISCOVERY_EFFORT=medium
# QUALIFY_EFFORT=low
# TAILOR_EFFORT=high
# ORIENT_EFFORT=high
# SCOUT_CONCURRENCY=8
# SCOUT_DISCOVERY_MAX_TURNS=40
# LLM_BATCH_POLL_S=30
# LLM_BATCH_TIMEOUT_S=86400
